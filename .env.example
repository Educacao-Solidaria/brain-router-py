# Copie para .env e preencha. O .env está no .gitignore — nunca o versione.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true

# postgresql://, postgres:// ou postgresql+asyncpg:// (normalizado para asyncpg)
DATABASE_URL=postgresql://brain:troque-me@localhost:5432/brain_router
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10           # segundos; conexão nova e health check
DB_POOL_RECYCLE=1800           # segundos; -1 desliga
DB_POOL_PRE_PING=true
DB_POOL_WARN_RATIO=0.8         # aviso de saturação: fração de DB_POOL_SIZE + DB_MAX_OVERFLOW
DB_ECHO=false

OPENROUTER_API_KEY=sk-or-v1-troque-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60

# flow-gateway-go (cliente em app/clients/gateway.py); sem GATEWAY_URL, o cliente não sobe.
# GATEWAY_URL=http://localhost:8080
# GATEWAY_API_KEY=
